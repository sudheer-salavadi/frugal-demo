---
const { title = 'Frugal Demo Blog' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #1a1a1a;
        background: #fafafa;
        line-height: 1.6;
      }
      main { max-width: 720px; margin: 0 auto; padding: 2rem 1rem 4rem; }
      a { color: #2563eb; text-decoration: none; }
      a:hover { text-decoration: underline; }
      img { max-width: 100%; border-radius: 8px; }
      header.site { padding: 1.5rem 1rem; border-bottom: 1px solid #e5e5e5; background: #fff; }
      header.site a { color: #1a1a1a; font-weight: 700; font-size: 1.1rem; }
    </style>
  </head>
  <body>
    <header class="site">
      <a href="/">Frugal Demo Blog</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
