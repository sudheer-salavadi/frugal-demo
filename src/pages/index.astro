---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Pipeline-published posts carry no image/description frontmatter, so fall
// back to the first inline image in the body and the seo_description field.
function coverImage(post) {
  if (post.data.image) return post.data.image;
  const match = post.body?.match(/<img[^>]*\ssrc="([^"]+)"/);
  return match ? match[1].replace(/^\/public\//, '/') : undefined;
}
---
<Base>
  <h1>Blog</h1>
  <ul style="list-style: none; padding: 0; display: grid; gap: 1.5rem;">
    {posts.map((post) => (
      <li style="background: #fff; border: 1px solid #e5e5e5; border-radius: 12px; overflow: hidden;">
        <a href={`/blog/${post.id}/`} style="display: block; color: inherit;">
          {coverImage(post) && (
            <img src={coverImage(post)} alt={post.data.title} style="width: 100%; height: 220px; object-fit: cover; border-radius: 0; display: block;" />
          )}
          <div style="padding: 1rem 1.25rem;">
            <h2 style="margin: 0 0 0.25rem;">{post.data.title}</h2>
            <time style="color: #6b7280; font-size: 0.85rem;">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            {(post.data.description ?? post.data.seo_description) && <p style="margin: 0.5rem 0 0; color: #4b5563;">{post.data.description ?? post.data.seo_description}</p>}
          </div>
        </a>
      </li>
    ))}
  </ul>
</Base>
